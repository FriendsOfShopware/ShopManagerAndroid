<?xml version="1.0" encoding="utf-8"?>
<!-- We push updates from the app (refresh/shop switch); updatePeriodMillis=0 disables
     the system's own polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="200dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_sales_desc"
    android:previewImage="@drawable/widget_preview_today"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout" />
