<?xml version="1.0" encoding="utf-8"?><!--
  See backup_rules.xml — auth ciphertexts are device-bound (AndroidKeyStore),
  snapshots are re-fetchable cache.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/app-data.json" />
        <exclude domain="file" path="snapshots" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/app-data.json" />
        <exclude domain="file" path="snapshots" />
    </device-transfer>
</data-extraction-rules>
